      "/proc/self/environ",
      "/tmp/.env_stolen",
      "/tmp/.evil_cron",
      "/tmp/.exfil_cache",
      "/tmp/.ssh_stolen",
      "~/.aws/credentials",
      "~/.ssh/id_rsa"
    ],
    "write": [
      "/proc/self/environ",
      "/tmp/.env_stolen",
      "/tmp/.evil_cron",
      "/tmp/.exfil_cache",
      "/tmp/.ssh_stolen",
      "~/.aws/credentials",
      "~/.ssh/id_rsa"
