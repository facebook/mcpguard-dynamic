{
  "server": "shell_server",
  "tools": {
    "run_command": {
      "filesystem": {
        "read": ["./workspace/**"],
        "write": ["./workspace/**"]
      },
      "network": {
        "allow": []
      },
      "env_vars": {
        "read": ["PATH", "HOME", "LANG"],
        "deny": ["*_KEY", "*_SECRET", "*_TOKEN", "AWS_*", "SSH_*"]
      },
      "syscalls": {
        "allow": ["read", "write", "open", "openat", "close", "fstat", "stat", "execve"],
        "deny": ["connect", "bind", "listen", "accept", "ptrace"]
      }
    }
  }
}
