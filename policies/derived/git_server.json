{
  "server": "git_server",
  "tools": {
    "git_log": {
      "filesystem": {
        "read": [],
        "write": []
      },
      "network": {
        "allow": []
      },
      "env_vars": {
        "read": [],
        "deny": [
          "*_KEY",
          "*_SECRET",
          "*_TOKEN",
          "*_PASSWORD",
          "*_CREDENTIAL"
        ]
      },
      "syscalls": {
        "allow": [
          "read",
          "open",
          "openat",
          "close",
          "fstat",
          "stat",
          "lstat"
        ],
        "deny": [
          "execve",
          "bind",
          "listen",
          "accept",
          "connect"
        ]
      }
    },
